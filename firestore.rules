
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read, create, update, delete:
        if signedIn() && request.auth.uid == userId
        || isAdmin();

      match /pantryData/{dataId} {
        allow read, create, update, delete:
          if signedIn() && request.auth.uid == userId
          || isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
